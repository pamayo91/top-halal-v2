RewriteCond %{QUERY_STRING} ^location=([a-z\-]*)&.*$
RewriteRule ^.*$ https://top-halal.fr/restos/%1? [R=301,L]
RewriteCond %{QUERY_STRING} ^location=([a-z\-]*)$
RewriteRule ^.*$ https://top-halal.fr/restos/%1? [R=301,L]
RewriteRule ^(.*)/comment-page-[0-9]$ https://top-halal.fr/$1 [R=301,L]
RewriteRule ^restaurants/hallal/cuisine-egyptienne.*$ https://top-halal.fr/specialites/variees? [R=301,L]
RewriteRule ^restaurants/hallal/cuisine-iranienne.*$ https://top-halal.fr/specialites/variees? [R=301,L]
RewriteRule ^restaurants/hallal/vietnamien.*$ https://top-halal.fr/specialites/variees? [R=301,L]
RewriteRule ^restaurants/hallal/coreen.*$ https://top-halal.fr/specialites/variees? [R=301,L]
RewriteRule ^restaurants/hallal/africainee.*$ https://top-halal.fr/specialites/cuisine-africaine? [R=301,L]

RewriteRule ^mosquee-de-paris/islam$ https://top-halal.fr/mosquee-de-paris/quest-ce-que-lislam? [L,R=301]
