RewriteRule ^restaurants/hallal/original.*$ https://top-halal.fr/service/original? [R=301,L]
RewriteRule ^restaurants/hallal/romantique.*$ https://top-halal.fr/service/romantique? [R=301,L]
RewriteRule ^restaurants/hallal/salle-de-priere.*$ https://top-halal.fr/service/salle-de-priere? [R=301,L]
RewriteRule ^restaurants/hallal/sans-alcool.*$ https://top-halal.fr/service/sans-alcool? [R=301,L]
RewriteRule ^restaurants/hallal/terrasse.*$ https://top-halal.fr/service/terrasse? [R=301,L]
RewriteRule ^restaurants/hallal/traiteur.*$ https://top-halal.fr/service/traiteur? [R=301,L]
RewriteRule ^restaurants/hallal/vente-a-emporter.*$ https://top-halal.fr/service/vente-a-emporter? [R=301,L]
RewriteRule ^restaurants/hallal/wi-fi.*$ https://top-halal.fr/service/wi-fi? [R=301,L]
